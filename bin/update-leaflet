#!/usr/bin/env bash

# Preparation
if [[ -d tmp/leaflet-geoman ]]; then
  echo "Updating the repository"
  cd tmp/leaflet-geoman
  git fetch origin
else
  echo "Cloning the repository at tmp/leaflet-geoman"
  git clone https://github.com/geoman-io/leaflet-geoman.git tmp/leaflet-geoman
  cd tmp/leaflet-geoman
fi

echo "Checking out latest version"
git checkout $(git tag | sort | tail -1)
npm i || echo "NOTE: Failure is expected in case you do not have PNPM installed."

# Change the build target
sed -i -E 's/(const buildOptions = \{)/\1\n  target: "es2021",/' bundle.mjs
# Disable minification
sed -i -E 's/minify: true,/minify: false,/' bundle.mjs
# Build
npm run build

# Move the files
DIST_FOLDER="app/packs/src/decidim/geoman"
GEOMAN_VERSION=$(grep '"version":' package.json | sed -E 's/\s+"version": "([^"]+)",/\1/')
cp dist/leaflet-geoman.js "../../${DIST_FOLDER}/leaflet-geoman-${GEOMAN_VERSION}.js"
cp dist/leaflet-geoman.css "../../${DIST_FOLDER}/leaflet-geoman-${GEOMAN_VERSION}.css"
cd ../..

echo ""
echo "Updated Leaflet-Geoman files available at:"
echo "  ${DIST_FOLDER}/leaflet-geoman-${GEOMAN_VERSION}.js"
echo "  ${DIST_FOLDER}/leaflet-geoman-${GEOMAN_VERSION}.css"
